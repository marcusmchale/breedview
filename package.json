{
  "name": "breedview",
  "version": "0.1.5",
  "private": true,
  "description": "Web interface to breedgraph",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js --fix",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:unit": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/unit/*.test.mjs",
    "guide:serve": "VITE_API_HOST=${GUIDE_API_URL:-http://localhost:8001} VITE_GUIDE_PRINT=1 vite build --outDir .guide-dist --emptyOutDir && vite preview --outDir .guide-dist --port 8081 --strictPort",
    "guide:doctor": "node guide/doctor.mjs",
    "guide:check": "node guide/record.mjs --fast",
    "guide:record": "node guide/record.mjs",
    "guide:encode": "node guide/encode.mjs",
    "guide:pdf": "node guide/pdf.mjs",
    "guide:site": "vite build --config vite.guide.config.js --mode guide",
    "guide:site:preview": "vite preview --config vite.guide.config.js --mode guide --port 8086",
    "guide:media-zip": "rm -f guide/out/guide-media.zip && mkdir -p guide/out && cd public && zip -qr ../guide/out/guide-media.zip guide-media",
    "perf:curation": "node tests/e2e/perf/curation.mjs",
    "perf:blocks": "node tests/e2e/perf/blocks.mjs",
    "perf:analysis": "node tests/e2e/perf/analysis.mjs",
    "perf:programs": "node tests/e2e/perf/programs.mjs"
  },
  "dependencies": {
    "@apollo/client": "^3.14.0",
    "@formkit/themes": "^1.6.9",
    "@formkit/vue": "^1.6.9",
    "@geoman-io/leaflet-geoman-free": "^2.19.0",
    "@protomaps/basemaps": "^5.7.2",
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.45",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vue/apollo-composable": "^4.2.2",
    "apollo-upload-client": "^17.0.0",
    "core-js": "^3.34.0",
    "d3": "^7.9.0",
    "graphql": "^16.11.0",
    "leaflet": "^1.9.4",
    "pmtiles": "^3.2.1",
    "protomaps-leaflet": "^5.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@rollup/plugin-graphql": "^2.0.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.4.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-prettier": "^5.1.0",
    "eslint-plugin-vue": "^9.19.0",
    "prettier": "^3.1.0",
    "vite": "^6.4.1"
  }
}
