# The demonstration site's build (vite build --mode demo): a banner above every page says what the site is
# (components/guide/DemoBanner.vue). It is served at /demo/ on production's host (breedgraph instance/demo/README.md);
# its API's address, VITE_API_HOST (https://<the host>/demo), goes in .env.demo.local, which git ignores.
VITE_DEMO_SITE=true
VITE_GRAPHQL_PATH=/graphql
VITE_BASE_PATH=/demo/
